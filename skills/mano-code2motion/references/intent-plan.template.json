  "compile": {
    "target": "MotionSpec v1 numeric adapter, or explicitly named new adapter",
    "unsupported_requirements": [
      "骨骼/3D等需新增适配器和测试，不得静默忽略"
    ],
    "artifacts": [
      "spec.json",
      "renderer with renderAt(seconds)",
