    "style": "参考与借鉴点，不等于套滤镜"
  },
  "objects": [
    {
      "id": "subject",
      "role": "主角/道具/背景",
      "material": "软/硬/阻尼/形变边界",
      "weight_perception": "轻/厚重的情境解释；未知质量不编造kg",
      "contact_constraints": [
        "接触阶段的世界坐标锚点"
      ],
      "design_reference": "造型由独立资产/关键原画定义"
    }
  ],
  "shots": [
    {
      "start_s": 0,
      "end_s": 4,
      "purpose": "一镜头的一件事",
      "key_poses": [
        "预备",
        "接触",
        "结束"
      ],
      "camera_intent": "固定或运动的原因",
      "transition_out": "有无跨镜锚点"
    }
  ],
  "translation_choices": [
    {
      "word": "丝滑",
      "context_candidates": [
        "物体速度连续",
        "相机跟随稳定"
      ],
      "selected": "依情境选择",
      "rejected_and_why": "不能套所有物体同ease",
