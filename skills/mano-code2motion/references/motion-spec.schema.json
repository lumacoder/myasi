{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumacoder.github.io/myasi/mano-code2motion/v1.schema.json",
  "title": "MotionSpec v1 — numeric Canvas demonstration",
  "type": "object",
  "properties": {
    "version": {
      "enum": [
        "1.0"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "height_px": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "width_px",
        "height_px",
        "background"
      ],
      "additionalProperties": false
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600
    },
    "intent": {
      "type": "object",
      "properties": {
        "original": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "original",
        "interpretation",
        "conflicts",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "version",
    "seed",
    "canvas",
    "fps",
    "duration_s",
    "intent",
    "objects",
    "tracks"
  ],
  "additionalProperties": false,
  "$defs": {
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "label": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "circle",
            "rect"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "width_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "x_px": {
          "type": "number"
        },
        "y_px": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation_rad": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "label",
        "shape",
        "color",
        "width_px",
        "height_px",
        "x_px",
        "y_px",
        "scale",
        "rotation_rad",
        "opacity"
      ],
      "additionalProperties": false
    },
    "ease": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "linear",
            "smoothstep",
            "smootherstep",
            "cubic-bezier"
          ]
        },
        "control": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string"
        },
        "property": {
          "enum": [
            "x_px",
            "y_px",
            "scale",
            "rotation_rad",
            "opacity"
          ]
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        },
        "ease": {
          "$ref": "#/$defs/ease"
        }
      },
      "required": [
        "object",
        "property",
        "start_s",
        "duration_s",
        "from",
        "to",
        "ease"
      ],
      "additionalProperties": false
    }
  }
}
